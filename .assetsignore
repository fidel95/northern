# Excludes files from the Cloudflare Workers static-assets bundle.
# assets.directory is "." (repo root) in wrangler.jsonc, so this keeps
# build-time artifacts and non-site files out of the deployed bundle.
node_modules
.wrangler
.git
.github
wrangler.jsonc
package.json
package-lock.json
yarn.lock
bun.lock
bun.lockb
.gitignore
.gitattributes
.editorconfig
README.md

# Source and documentation for the visualizer's demo-home models — the .glb
# files they produce ship, the tools that produce them don't.
visualizer/models/*.py
visualizer/models/ASSET-SPEC.md

# Design handoff material, kept in the repo but not part of the site.
prototype-files-needed
*.zip
northern-pines-website-build-prompt.md
